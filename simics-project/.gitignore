# Entire Simics project scaffold generated by `ispm projects --create` +
# `bin/project-setup`. Regenerate it any time: ispm creates the project,
# project-setup adds the device skeleton under modules/. Only modules/<device>/
# (the actual DML source) is tracked.
/bin/
/build/
/linux64/
/win64/
/targets/
/.modcache
/.project-properties/
/.package-list
/simics
/documentation
/config.mk
/logs/
/CMakeLists.txt
/cmake-wrapper.mk
/compiler.mk
/GNUmakefile
/gui-requirements.txt
/requirements.txt

*.pyc
__pycache__/
autodml/devices/*/ccc/iter-*/work/
modules/*/graphify-out/
modules/*/test/graphify-out/
/test/
/graphify-out/
*.project-setup.new
*.~1~
/bt/
/test/coverage/
modules/*/autodml/memory/graphify-out/

# Editor / OS cruft
.DS_Store
*.swp
*~
autodml/memories/sessions/
